# Local connection page
HOST=127.0.0.1
PORT=8080

# React to a voice note from your own account to request a transcription.
TRANSCRIPTION_REACTION=🤖
TRANSCRIPTION_LANGUAGE=auto

# Download this model automatically, or set an existing GGML model path below.
WHISPER_MODEL=large-v3-turbo
WHISPER_LOCAL_MODEL_PATH=
USE_GPU=false

# Optional: absolute path to FFmpeg if it is not on PATH.
FFMPEG_PATH=ffmpeg
