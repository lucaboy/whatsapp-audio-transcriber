  "license": "GPL-3.0",
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "node-wav": "^0.0.2",
    "qrcode": "^1.5.4",
    "smart-whisper": "^0.8.1",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/node-wav": "^0.0.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=22"
